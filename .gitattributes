# Files that run inside Linux containers keep LF on every checkout: a CR after the shebang makes exec fail
# ("no such file or directory"), which stopped the first pilot session before it started (E152).
*.sh text eol=lf
seed/founder/Dockerfile text eol=lf
# Seed vector fixtures are read byte for byte (tarball hashes, diff headers, line numbers): never converted.
seed/bootstrap/vectors/secrets/** -text
seed/bootstrap/vectors/profile/** -text
seed/bootstrap/vectors/npmlock/** -text
seed/bootstrap/vectors/recipe/** -text
seed/bootstrap/vectors/diffguard/** -text
# MF8-MF11's too: k0map's manifests hash its run files, append's append-only check compares ledger lines byte for byte.
seed/bootstrap/vectors/k0map/** -text
seed/bootstrap/vectors/refs/** -text
seed/bootstrap/vectors/append/** -text
seed/bootstrap/vectors/root/** -text
